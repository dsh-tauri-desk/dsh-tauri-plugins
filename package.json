{
  "name": "dsh-tauri-plugins",
  "type": "module",
  "version": "0.4.1",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "Tauri desktop plugins for DeepSeek Harness.",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins"
  },
  "bugs": "https://github.com/dsh-tauri-desk/dsh-tauri-plugins/issues",
  "keywords": [
    "dsh",
    "plugin",
    "dsh-plugin",
    "dsh-tauri",
    "react",
    "react-dom",
    "tauri",
    "deepseek-harness"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "lint": "eslint .",
    "release": "bumpp -r",
    "test": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/dsh-client-runtime": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "bumpp": "catalog:cli",
    "css-render": "catalog:ui",
    "dsh-tauri-tsdown": "workspace:*",
    "eslint": "catalog:cli",
    "lint-staged": "catalog:cli",
    "publint": "catalog:cli",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "simple-git-hooks": "catalog:cli",
    "tinyexec": "catalog:testing",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing",
    "vitest-package-exports": "catalog:testing",
    "yaml": "catalog:testing"
  },

  "simple-git-hooks": {
    "pre-commit": "pnpm install --frozen-lockfile --ignore-scripts --offline && pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
