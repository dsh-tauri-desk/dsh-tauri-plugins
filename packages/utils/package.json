{
  "name": "@pkg-placeholder/utils",
  "type": "module",
  "version": "0.0.0",
  "description": "Shared utilities - example sub-package",
  "author": "Hairyf <wwu710632@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hairyf/pkg-placeholder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/pkg-placeholder.git"
  },
  "bugs": "https://github.com/hairyf/pkg-placeholder/issues",
  "keywords": [
    "utils"
  ],
  "sideEffects": false,
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "nr build",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@antfu/ni": "catalog:cli",
    "@types/node": "catalog:types",
    "tsdown": "catalog:cli",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  }
}
